<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🦦 ROMO today" android:textColor="#0f766e" android:textStyle="bold" android:textSize="14sp" />
    <TextView android:id="@+id/widget_goals" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:text="Open Romo to sync 🦦" android:textColor="#1f2937" android:textSize="13sp" android:gravity="top" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🦦 ROMO" android:textColor="#6b7280" android:textSize="11sp" />
</LinearLayout>
